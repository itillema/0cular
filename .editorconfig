# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{*.go,go.mod,go.sum}]
indent_style = tab

[justfile]
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

# Fixtures are compared byte for byte: editors must not trim whitespace or
# add or remove final newlines.
[{**/testdata/**,*.golden,replay/*/baseline.*,replay/*/candidate.*}]
insert_final_newline = unset
trim_trailing_whitespace = unset
